[Unit]
Description=Deploy the tested Jobevent main revision
After=docker.service network-online.target
Wants=network-online.target
[Service]
Type=oneshot
EnvironmentFile=/etc/jobevent-cd.conf
StateDirectory=jobevent-cd
StateDirectoryMode=0700
ExecStart=/usr/local/libexec/jobevent-cd
TimeoutStartSec=15min
Nice=10
UMask=0077
